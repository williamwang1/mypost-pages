// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl         = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
  shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING") // used for migrations
}

model Follow {
  id                String  @id @default(cuid())
  digest            String  @unique
  follower          String  
  following         String
  following_id      String
  following_profile String
  follower_id       String
  follower_profile  String
  price             String
  type              String
  create_at         DateTime
  status            Boolean @default(true)
}

model RepostAccess {
  id                   String  @id @default(cuid())
  digest               String  @unique
  access_id            String  
  repost_id             String 
  repost_pool_id        String
  repost_digest         String
  transaction_digest   String
  repost_profile_id     String
  price                String
  type                 String 
  address              String
  package_id           String
  create_at            DateTime
  status               Boolean @default(true)         
}

model ReplyAccess {
  id                   String  @id @default(cuid())
  digest               String  @unique
  access_id            String  
  reply_id             String 
  reply_pool_id        String
  reply_digest         String
  transaction_digest   String
  reply_profile_id     String
  price                String
  type                 String 
  address              String
  package_id           String
  create_at            DateTime
  status               Boolean @default(true)         
}

model Access {
  id                   String  @id @default(cuid())
  digest               String  @unique
  access_id            String  
  transaction_id       String 
  pool_id              String
  transaction_digest   String
  profile_id           String
  price                String
  type                 String 
  address              String
  package_id           String
  create_at            DateTime
  status               Boolean @default(true)         
}

model Repost {
  id                   String  @id @default(cuid())
  digest               String  @unique
  transaction_digest   String  
  public_content       String  @db.Text
  address              String
  profile_id           String
  repost_id             String  @unique
  pool_id              String  @unique
  package_id           String
  repost_post_id        String
  transaction_post_id  String
  type                 String
  create_at            DateTime
}

model Reply {
  id                   String  @id @default(cuid())
  digest               String  @unique
  transaction_digest   String  
  public_content       String  @db.Text
  address              String
  profile_id           String
  reply_id             String  @unique
  pool_id              String  @unique
  package_id           String
  reply_post_id        String
  transaction_post_id  String
  type                 String
  create_at            DateTime
}

model Transaction {
  id               String  @id @default(cuid())
  digest           String  @unique
  summary          String? @db.Text
  public_content   String  @db.Text
  address          String
  profile_id       String
  transaction_id   String  @unique
  pool_id          String  @unique
  package_id       String
  post_id          String
  type             String
  create_at        DateTime
}


model Profile {
  id                String  @id @default(cuid())
  address           String  @unique
  digest            String
  profile_id        String  
  profile_pool_id   String
  profile_meta_id   String
  global_id         String
  package_id        String
  create_at         DateTime       
}

model Account {
  id                String  @id @default(cuid())
  name              String?
  email             String?
  emailVerified     Boolean?
  image             String?
  type              String?
  provider          String
  oauth_token       String?
  oauth_token_secret String?
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  address           String
  create_at         DateTime
  profile           String? @db.Text
  status            Boolean @default(true)
  @@unique([providerAccountId, provider, address, status])
}





