// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl         = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
  shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING") // used for migrations
}

model Follow {
  id                String  @id @default(cuid())
  digest            String
  follower          String  
  following         String
  following_id      String
  following_profile String
  follower_id       String
  follower_profile  String
  price             String
  create_at         DateTime
  status            Boolean
  @@unique([follower, following])
}

model AccessBought {
  id                   String  @id @default(cuid())
  digest               String  @unique
  access_id            String  @unique
  transaction_id       String
  transaction_digest   String
  profile_id           String
  accessor_profile     String
  price                String
  address              String
  package_id           String
  create_at            DateTime
  status               Boolean          
}

model Transaction {
  id               String  @id @default(cuid())
  digest           String  @unique
  summary          String  @db.Text
  public_content   String  @db.Text
  address          String
  profile_id       String
  create_at        DateTime
}

model TransactionMeta {
  id                String  @id @default(cuid())
  digest            String  @unique
  transaction_id    String  @unique
  pool_id           String  @unique
  profile_id        String
  address           String
  package_id        String
  create_at         DateTime
}


model Profile {
  id                String  @id @default(cuid())
  address           String  @unique
  digest            String
  profile_id        String  
  profile_pool_id   String
  profile_meta_id   String
  global_id         String
  package_id        String
  create_at         DateTime       
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  oauth_token       String?
  oauth_token_secret String?
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
